# DOCUMIND AI — Environment Configuration
# Supported AI Providers: 'gemini' | 'openai' | 'local' (built-in deterministic evidence extraction engine)

# Active Provider (default is 'gemini' if key present, otherwise falls back gracefully to 'local')
AI_PROVIDER=gemini

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# App Configuration
PORT=3000
NODE_ENV=development
DATA_DIR=.documind
